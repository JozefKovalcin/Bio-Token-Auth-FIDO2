# Generate real local values with scripts/Init-Lan.ps1.
# Resolve this stable LAN hostname to the server IP on both PC and Android.
APP_HOST=auth.bio-token.test
POSTGRES_PASSWORD=
# 32 cryptographically random bytes encoded as 64 hex characters.
TOTP_ENCRYPTION_KEY=
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=auth.bio-token.test
# Container path; trusted PUBLIC Yubico root certificates as a JSON PEM array.
WEBAUTHN_TRUSTED_ROOTS_FILE=/config/webauthn-roots.json
WEBAUTHN_AAGUID_ALLOWLIST=
# Enable C only after physical acceptance tests and attestation configuration.
MODE_C_ENABLED=false
MODE_C_HARDWARE_VERIFIED=false
ATTESTATION_SERVICE_URL=http://attestation:8081
ATTESTATION_SERVICE_TOKEN=
ATTESTATION_PACKAGE_NAME=sk.biotoken.android
ATTESTATION_SIGNING_CERT_SHA256=
ATTESTATION_MIN_APP_VERSION=1
# For development outside Compose, also set DATABASE_URL and APP_ORIGIN.
# DATABASE_URL=postgresql://bio_auth:YOUR_LOCAL_PASSWORD@localhost:5432/bio_auth
# APP_ORIGIN=https://auth.bio-token.test
