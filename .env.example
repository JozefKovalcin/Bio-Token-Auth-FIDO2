# Generate real local values with scripts/Init-Lan.ps1.
# Use one reachable IPv4 address or DNS hostname, without scheme or port.
APP_HOST=192.168.1.50
POSTGRES_PASSWORD=
# 32 cryptographically random bytes encoded as 64 hex characters.
TOTP_ENCRYPTION_KEY=
# For development outside Compose, also set DATABASE_URL and APP_ORIGIN.
# DATABASE_URL=postgresql://bio_auth:YOUR_LOCAL_PASSWORD@localhost:5432/bio_auth
# APP_ORIGIN=https://192.168.1.50
